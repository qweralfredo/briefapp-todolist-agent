# ==============================================================================
# Briefapp V3 Release MVP — Environment Variable Definitions
# Copy this file to '.env' before running docker compose
# ==============================================================================

# Core Database Settings
DB_PASSWORD=briefapp-prod-secret-change-me

# Redis Settings
REDIS_PASSWORD=briefapp-redis-secret

# API & Security Keys
PANDORA_API_KEY=your-secure-production-api-key

# Vector DB / Context-Box Minio
MINIO_PASSWORD=briefapp-minio-secret
GEMINI_API_KEY=your-gemini-api-key-here

# OpenClaw Gateway (Box 4)
OPENCLAW_ADMIN_KEY=openclaw-admin-api-key
OPENCLAW_WEBHOOK_SECRET=your-webhook-hmac-secret-signature

# OpenClaw Integrations (Set to true and provide tokens when enabling channels)
WHATSAPP_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=

# Frontend Runtime Injection
VITE_API_BASE_URL=http://localhost:8080
